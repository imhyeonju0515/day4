# 브라우저에 노출되어도 되는 값 (Supabase > Project Settings > API)
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=여기에_anon_또는_publishable_key

# 서버(api/pixabay.js)에서만 쓰는 비밀 값 - VITE_ 접두사를 붙이지 마세요!
PIXABAY_API_KEY=여기에_pixabay_api_key

# 공공데이터포털(data.go.kr) 인증키 - 기상청 단기예보(초단기실황) 날씨용. 서버 전용, VITE_ 금지
DATA_GO_KR_KEY=여기에_공공데이터포털_인증키
# (위 DATA_GO_KR_KEY 하나로 날씨와 서귀포 관람객 추이를 모두 씁니다. 단, data.go.kr 에서 두 API 모두 활용신청해야 해요)
